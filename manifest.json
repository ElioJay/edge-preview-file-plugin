{
  "manifest_version": 3,
  "name": "Preview Any File",
  "version": "0.1.0",
  "description": "在 Edge 中直接预览网页上的 TOML、YAML、JSON、TXT、LOG、.env、Markdown 文件，无需下载。",
  "permissions": ["downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*.toml*",
        "https://*/*.toml*",
        "http://*/*.TOML*",
        "https://*/*.TOML*",
        "http://*/*.yaml*",
        "https://*/*.yaml*",
        "http://*/*.YAML*",
        "https://*/*.YAML*",
        "http://*/*.yml*",
        "https://*/*.yml*",
        "http://*/*.YML*",
        "https://*/*.YML*",
        "http://*/*.txt*",
        "https://*/*.txt*",
        "http://*/*.TXT*",
        "https://*/*.TXT*",
        "http://*/*.log*",
        "https://*/*.log*",
        "http://*/*.LOG*",
        "https://*/*.LOG*",
        "http://*/*.env*",
        "https://*/*.env*",
        "http://*/*.ENV*",
        "https://*/*.ENV*",
        "http://*/*.md*",
        "https://*/*.md*",
        "http://*/*.MD*",
        "https://*/*.MD*",
        "http://*/*.markdown*",
        "https://*/*.markdown*",
        "http://*/*.MARKDOWN*",
        "https://*/*.MARKDOWN*",
        "http://*/*.json*",
        "https://*/*.json*",
        "http://*/*.JSON*",
        "https://*/*.JSON*"
      ],
      "js": [
        "src/prism-config.js",
        "vendor/prism.min.js",
        "vendor/prism-toml.min.js",
        "vendor/prism-yaml.min.js",
        "vendor/prism-log.min.js",
        "vendor/prism-markdown.min.js",
        "vendor/prism-json.min.js",
        "vendor/prism-json5.min.js",
        "vendor/marked.umd.js",
        "vendor/purify.min.js",
        "src/decode.js",
        "src/registry.js",
        "src/renderers/toml.js",
        "src/renderers/yaml.js",
        "src/renderers/txt.js",
        "src/renderers/log.js",
        "src/dotenv-names.js",
        "src/renderers/env.js",
        "src/renderers/markdown.js",
        "src/renderers/json.js",
        "src/app.js",
        "src/content.js"
      ],
      "css": ["viewer.css"],
      "run_at": "document_idle"
    }
  ]
}
